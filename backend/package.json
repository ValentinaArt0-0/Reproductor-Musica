{
  "name": "music-player-backend",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "smoke": "tsx src/smoke.ts",
    "check:search": "tsx src/search-check.ts",
    "check:stream": "tsx src/stream-check.ts",
    "check": "tsx src/search-check.ts && tsx src/stream-check.ts && tsx src/smoke.ts"
  },
  "dependencies": {
    "@distube/ytdl-core": "^4.16.12",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "multer": "^2.0.0",
    "music-metadata": "^7.14.0",
    "yt-search": "^2.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.14.0",
    "@types/yt-search": "^2.10.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
